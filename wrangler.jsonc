// Configuração do Worker de arquivos estáticos (projeto "nizity" na Cloudflare).
// not_found_handling: endereço que não existe recebe o 404.html (antes vinha uma resposta vazia).
{
  "name": "nizity",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  }
}
